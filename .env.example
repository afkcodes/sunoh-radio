# Database Configuration
DB_USER=sunoh
DB_HOST=localhost
DB_NAME=sunoh_radio_db
DB_PASSWORD=change_me
DB_PORT=5433
# Connection pool tuning (optional)
DB_POOL_MAX=15
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000

# API Configuration (optional)
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated allow-list; use an explicit list in production instead of '*'
CORS_ORIGINS=*
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
API_MAX_LIMIT=100
API_DEFAULT_LIMIT=50
API_MAX_OFFSET=50000
AGGREGATE_CACHE_TTL=600

# Admin web UI (/admin) — REQUIRED in production
ADMIN_PASSWORD=change_me_strong
SESSION_SECRET=change_me_to_a_long_random_string
SESSION_TTL=7d

# Scraping Configuration
MAX_WORKERS=5
PROBE_TIMEOUT=15
# Optional dir prepended to PATH so node/npx resolve when the orchestrator
# shells out (e.g. an nvm/n install). Leave blank if node is already on PATH.
NODE_BIN_PATH=

# Cloudinary Configuration (for `npm run host-images`)
# Either set these three (from your Cloudinary dashboard)...
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# ...or a single CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_FOLDER=radio-stations

# Image hosting worker (optional)
# Cap uploads per run — set small (e.g. 100) for a first test, then 0 for full.
HOST_IMAGE_LIMIT=0
HOST_IMAGE_BATCH=50
HOST_IMAGE_MAX_ATTEMPTS=5
# Host logos only for working stations (true) or all rows (false).
HOST_IMAGE_WORKING_ONLY=true
